@DBN.Gen.bridge : ∀ {N : ℕ} [inst : NeZero N] {χ : DirichletCharacter ℂ N} {c : ℕ → ℝ} {k : ℕ},
  χ ≠ (1 : DirichletCharacter ℂ N) →
    (∀ (n : ℕ), χ ↑n = ↑(c n)) →
      ∀ (hc : ∀ (n : ℕ), |c n| ≤ (1 : ℝ)) (hc0 : c (0 : ℕ) = (0 : ℝ)) (hc1 : c (1 : ℕ) = (1 : ℝ)),
        (∀ (s : ℂ), χ.gammaFactor s = (s + ↑k).Gammaℝ) →
          ∀ (heven : ∀ (u : ℝ), DBN.Gen.PhiC c k (↑N) (-u) = DBN.Gen.PhiC c k (↑N) u) (z : ℂ),
            (DBN.Gen.thetaDecayKernel hc hc0 hc1 ⋯ heven).Hd (0 : ℝ) z =
              (1 / 8 : ℂ) * ↑N ^ (((1 / 2 : ℂ) + Complex.I * z / (2 : ℂ) + ↑k) / (2 : ℂ)) *
                DirichletCharacter.completedLFunction χ ((1 / 2 : ℂ) + Complex.I * z / (2 : ℂ))
'DBN.Gen.bridge' depends on axioms: [propext, Classical.choice, Quot.sound]
