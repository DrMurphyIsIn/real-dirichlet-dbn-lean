DBN.Gen.gaussG_eq : ∀ (N : ℕ) [NeZero N],
  DBN.Gen.gaussG N = ((1 : ℂ) + Complex.I) * ((1 : ℂ) + (-Complex.I) ^ N) / (2 : ℂ) * ↑√↑N
def DBN.Gen.gaussG : ℕ → ℂ :=
fun N => ∑ j, Complex.exp (2 * ↑Real.pi * Complex.I * ↑↑j ^ 2 / ↑N)
@DBN.Gen.rootNumber_eq_one_of_prime : ∀ {p : ℕ} [hp : Fact (Nat.Prime p)],
