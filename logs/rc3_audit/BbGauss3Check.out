@DBN.Gen.rootNumber_eq_one_of_real_primitive : ∀ {N : ℕ} [inst : NeZero N] (χ : DirichletCharacter ℂ N),
  χ.IsPrimitive → (∀ (n : ℕ), (χ ↑n).im = (0 : ℝ)) → χ.rootNumber = (1 : ℂ)
@DBN.Gen.real_primitive_real_zeros : ∀ {N : ℕ} [inst : NeZero N] (χ : DirichletCharacter ℂ N),
  χ.IsPrimitive →
    χ ≠ (1 : DirichletCharacter ℂ N) →
      (∀ (n : ℕ), (χ ↑n).im = (0 : ℝ)) →
        (∀ (s : ℂ), (7 / 8 : ℝ) < s.re → DirichletCharacter.LFunction χ s ≠ (0 : ℂ)) →
          ∀ (t : ℝ), (9 / 32 : ℝ) ≤ t → ∀ (z : ℂ), DBN.Gen.Hchi χ t z = (0 : ℂ) → z.im = (0 : ℝ)
'DBN.Gen.rootNumber_eq_one_of_real_primitive' depends on axioms: [propext, Classical.choice, Quot.sound]
'DBN.Gen.real_primitive_real_zeros' depends on axioms: [propext, Classical.choice, Quot.sound]
