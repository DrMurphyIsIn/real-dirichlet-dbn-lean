@DBN.Gen.zero_strip : ∀ {N : ℕ} [inst : NeZero N] {χ : DirichletCharacter ℂ N} {c : ℕ → ℝ} {k : ℕ},
  χ.IsPrimitive →
    χ ≠ (1 : DirichletCharacter ℂ N) →
      (∀ (n : ℕ), χ ↑n = ↑(c n)) →
        ∀ (hc : ∀ (n : ℕ), |c n| ≤ (1 : ℝ)) (hc0 : c (0 : ℕ) = (0 : ℝ)) (hc1 : c (1 : ℕ) = (1 : ℝ)),
          (∀ (s : ℂ), χ.gammaFactor s = (s + ↑k).Gammaℝ) →
            ∀ (heven : ∀ (u : ℝ), DBN.Gen.PhiC c k (↑N) (-u) = DBN.Gen.PhiC c k (↑N) u),
              (∀ (s : ℂ), (7 / 8 : ℝ) < s.re → DirichletCharacter.LFunction χ s ≠ (0 : ℂ)) →
                ∀ (z : ℂ),
                  (DBN.Gen.thetaDecayKernel hc hc0 hc1 ⋯ heven).Hd (0 : ℝ) z = (0 : ℂ) → z.im ^ (2 : ℕ) ≤ (9 / 16 : ℝ)
@DBN.Gen.dirichlet_real_zeros : ∀ {N : ℕ} [inst : NeZero N] {χ : DirichletCharacter ℂ N} {c : ℕ → ℝ} {k : ℕ},
  χ.IsPrimitive →
    χ ≠ (1 : DirichletCharacter ℂ N) →
      (∀ (n : ℕ), χ ↑n = ↑(c n)) →
        ∀ (hc : ∀ (n : ℕ), |c n| ≤ (1 : ℝ)) (hc0 : c (0 : ℕ) = (0 : ℝ)) (hc1 : c (1 : ℕ) = (1 : ℝ)),
          (∀ (s : ℂ), χ.gammaFactor s = (s + ↑k).Gammaℝ) →
            ∀ (heven : ∀ (u : ℝ), DBN.Gen.PhiC c k (↑N) (-u) = DBN.Gen.PhiC c k (↑N) u),
              (∀ (s : ℂ), (7 / 8 : ℝ) < s.re → DirichletCharacter.LFunction χ s ≠ (0 : ℂ)) →
                ∀ (t : ℝ),
                  (9 / 32 : ℝ) ≤ t →
                    ∀ (z : ℂ), (DBN.Gen.thetaDecayKernel hc hc0 hc1 ⋯ heven).Hd t z = (0 : ℂ) → z.im = (0 : ℝ)
