@DBN.Gen.Hchi_bridge : ∀ {N : ℕ} [inst : NeZero N] (χ : DirichletCharacter ℂ N),
  χ.IsPrimitive →
    χ ≠ (1 : DirichletCharacter ℂ N) →
      (∀ (n : ℕ), (χ ↑n).im = (0 : ℝ)) →
        ∀ (z : ℂ),
          DBN.Gen.Hchi χ (0 : ℝ) z =
            (1 / 8 : ℂ) * ↑N ^ (((1 / 2 : ℂ) + Complex.I * z / (2 : ℂ) + ↑(DBN.Gen.parityK χ)) / (2 : ℂ)) *
              DirichletCharacter.completedLFunction χ ((1 / 2 : ℂ) + Complex.I * z / (2 : ℂ))
'DBN.Gen.Hchi_bridge' depends on axioms: [propext, Classical.choice, Quot.sound]
