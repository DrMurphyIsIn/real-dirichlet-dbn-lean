bb: regression statement Expr.eqv island dbn_debruijn_parametric = true
@DBN.Gen.dbn_debruijn_parametric : ∀ {K : DBN.Gen.Kernel} (t0 Y : ℝ),
  (∀ (z : ℂ), DBN.Gen.H K t0 z = (0 : ℂ) → z.im ^ (2 : ℕ) ≤ Y) →
    ∀ (t : ℝ), t0 ≤ t → ∀ (z : ℂ), DBN.Gen.H K t z = (0 : ℂ) → z.im ^ (2 : ℕ) ≤ max (Y - (2 : ℝ) * (t - t0)) (0 : ℝ)
structure DBN.Gen.Kernel : Type
number of parameters: 0
fields:
  DBN.Gen.Kernel.Φ : ℝ → ℝ
  DBN.Gen.Kernel.cont : Continuous self.Φ
  DBN.Gen.Kernel.even : ∀ (u : ℝ), self.Φ (-u) = self.Φ u
  DBN.Gen.Kernel.C : ℝ
  DBN.Gen.Kernel.C_nonneg : 0 ≤ self.C
  DBN.Gen.Kernel.bound : ∀ {u : ℝ}, 0 ≤ u → |self.Φ u| ≤ self.C * (rexp (9 * u) * rexp (-(π / 2) * rexp (4 * u)))
  DBN.Gen.Kernel.ne : ∃ u, self.Φ u ≠ 0
constructor:
  DBN.Gen.Kernel.mk (Φ : ℝ → ℝ) (cont : Continuous Φ) (even : ∀ (u : ℝ), Φ (-u) = Φ u) (C : ℝ) (C_nonneg : 0 ≤ C)
    (bound : ∀ {u : ℝ}, 0 ≤ u → |Φ u| ≤ C * (rexp (9 * u) * rexp (-(π / 2) * rexp (4 * u)))) (ne : ∃ u, Φ u ≠ 0) :
    DBN.Gen.Kernel
'bb_regression' depends on axioms: [propext, Classical.choice, Quot.sound]
