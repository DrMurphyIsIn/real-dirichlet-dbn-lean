bb_real_primitive_meaning_oai : (∀ {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N),
    χ.IsPrimitive →
      χ ≠ (1 : DirichletCharacter ℂ N) →
        (∀ (n : ℕ), (χ ↑n).im = (0 : ℝ)) →
          ∀ (t : ℝ), (9 / 32 : ℝ) ≤ t → ∀ (z : ℂ), DBN.Gen.Hchi χ t z = (0 : ℂ) → z.im = (0 : ℝ)) ∧
  ∀ {N : ℕ} [inst : NeZero N] (χ : DirichletCharacter ℂ N),
    χ.IsPrimitive →
      χ ≠ (1 : DirichletCharacter ℂ N) →
        (∀ (n : ℕ), (χ ↑n).im = (0 : ℝ)) →
          ∀ (z : ℂ),
            DBN.Gen.Hchi χ (0 : ℝ) z =
              (1 / 8 : ℂ) * ↑N ^ (((1 / 2 : ℂ) + Complex.I * z / (2 : ℂ) + ↑(DBN.Gen.parityK χ)) / (2 : ℂ)) *
                DirichletCharacter.completedLFunction χ ((1 / 2 : ℂ) + Complex.I * z / (2 : ℂ))
